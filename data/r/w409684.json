{"id":"w409684","name":"Hamburger Stoup","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Hamburger_Stoup"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Hamburger_Stoup"},"image":"","cuisine":"","country":"","region":"Global","course":"soup","protein":"beef","diet":0,"allergens":1462273,"minutes":390,"time":{"prep":30,"cook":360,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"2 lbs lean (80/20) ground beef","qty":""},{"item":"1 large onion, chopped","qty":""},{"item":"3 cans (36 oz) cans stewed tomatoes","qty":""},{"item":"2 cans (16 oz) corn","qty":""},{"item":"1 can (8 oz) peas","qty":""},{"item":"6 large stalks celery, chopped","qty":""},{"item":"6 large potatoes, cubed","qty":""},{"item":"1 can (8 oz) beef broth","qty":""},{"item":"1 can (8 oz) can chicken broth","qty":""},{"item":"1 cup white rice","qty":""},{"item":"2 tbsp salt","qty":""},{"item":"2 tbsp pepper","qty":""},{"item":"Cooked pasta (optional)","qty":""}],"steps":["Fry the onions in a skillet with a dash of oil until the onions are translucent.","Add the ground beef to the onions. Cook, breaking the meat up, until browned.","Combine meat mixture and remaining ingredients in a large stockpot. Add enough water to cover everything by a few inches (usually about 2 cups).","Place pot in a 325°F oven, and bake for 6 hours.","If using pasta, stir in after removing from the oven."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":67,"era":"modern"}