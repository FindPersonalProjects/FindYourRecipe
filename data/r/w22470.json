{"id":"w22470","name":"Oatmeal Chocolate Chip Cookies III","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Oatmeal_Chocolate_Chip_Cookies_III"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Oatmeal_Chocolate_Chip_Cookies_III"},"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Ginny\u0027s%20Toll%20House%20Cookies%20Alc1.jpg?width=640","cuisine":"","country":"","region":"Global","course":"dessert","protein":"veggie","diet":2,"allergens":7,"minutes":30,"time":{"prep":20,"cook":10,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"1 stick butter, softened","qty":""},{"item":"⅓ cup white granulated sugar","qty":""},{"item":"½ cup brown sugar","qty":""},{"item":"1 egg","qty":""},{"item":"½ tsp vanilla extract","qty":""},{"item":"½ tsp salt","qty":""},{"item":"½ tsp baking soda","qty":""},{"item":"1 cup plus 2 tbsp flour","qty":""},{"item":"¼ cup rolled oats (oatmeal)","qty":""},{"item":"½ cup chocolate chips","qty":""}],"steps":["Preheat oven to 375°F.","Cream together butter and sugars.","Add egg and vanilla and mix.","Add salt, baking soda, and flour; mix.","Mix in oatmeal.","Mix in chocolate chips.","Scoop cookies onto a greased or parchment-lined baking sheet.","Bake 9–11 minutes at 375°F."],"tags":[],"youtube":"","culture":{"text":"These are traditional chewy chocolate chip cookies with oatmeal added to provide a bit of extra body to the cookie.","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Oatmeal_Chocolate_Chip_Cookies_III"}},"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}