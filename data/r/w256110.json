{"id":"w256110","name":"Taco Casserole","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Taco_Casserole"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Taco_Casserole"},"image":"","cuisine":"Tex-Mex","country":"","region":"Americas","course":"main","protein":"beef","diet":0,"allergens":3,"minutes":30,"time":{"prep":10,"cook":20,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"6","difficulty":"easy","ingredients":[{"item":"1 pound (450 g) ground beef","qty":""},{"item":"1 taco seasoning packet","qty":""},{"item":"3 tbsp chili powder","qty":""},{"item":"3 tbsp garlic powder","qty":""},{"item":"8 ounces (225 g) tomato sauce","qty":""},{"item":"3 tortillas in bits","qty":""},{"item":"3 cups shredded cheese","qty":""}],"steps":["Brown the ground beef in skillet on medium heat.","Drain the ground beef.","Dump the ground beef back in the skillet.","While on medium heat mix in the taco seasoning, the chili powder, the garlic powder, and the tomato sauce.","Simmer for 5 minutes, stirring occasionally.","Mix the ground beef mixture, tortilla bits, and the cheese together in a casserole dish.","Bake in oven at 375°F (190°C) for 20 minutes.","Serve hot."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0"}