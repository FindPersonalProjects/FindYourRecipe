{"id":"w18884","name":"Albanian Stewed Fig Pudding","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Albanian_Stewed_Fig_Pudding"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Albanian_Stewed_Fig_Pudding"},"image":"","cuisine":"Albanian","country":"","region":"Europe","course":"dessert","protein":"veggie","diet":2,"allergens":2,"minutes":15,"time":{"prep":10,"cook":5,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"4","difficulty":"easy","ingredients":[{"item":"1 cup (240 g) white granulated sugar","qty":""},{"item":"4 cups (900 ml) milk","qty":""},{"item":"1 cup (240 g) finely-grated dried figs","qty":""},{"item":"Ground cinnamon","qty":""}],"steps":["Stir sugar into milk, bring to a boil, and remove from heat. Gradually add figs, stirring continuously.","Pour into earthenware serving bowls and bake in moderate oven (350°F or 180°C) for 10 minutes.","Chill and sprinkle with cinnamon.","Serve cold."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0"}