{"id":"w204705","name":"Orange French Toast","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Orange_French_Toast"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Orange_French_Toast"},"image":"","cuisine":"French","country":"","region":"Europe","course":"breakfast","protein":"veggie","diet":2,"allergens":7,"minutes":545,"time":{"prep":20,"cook":40,"passive":485,"passiveWhy":["soaking","chilling"]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"6 eggs, lightly beaten","qty":""},{"item":"¾ cup orange juice","qty":""},{"item":"½ cup half-and-half cream","qty":""},{"item":"2 tbsp sugar","qty":""},{"item":"1 tsp vanilla extract","qty":""},{"item":"½ tsp grated orange peel","qty":""},{"item":"8 thick slices cinnamon bread","qty":""},{"item":"¼ cup butter, melted","qty":""}],"steps":["In a shallow bowl, combine the eggs, orange juice, half-and-half, sugar, vanilla, and orange peel.","Dip both sides of bread into egg mixture; let soak for 5 minutes.","Place in a greased baking pan.","Cover and refrigerate overnight.","Uncover, and drizzle with butter.","Bake at 325°F for 35–40 minutes or until browned."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}