{"id":"w136641","name":"Thai Red Curry Paste","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Thai_Red_Curry_Paste"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Thai_Red_Curry_Paste"},"image":"","cuisine":"Thai","country":"","region":"Southeast Asia","course":"main","protein":"seafood","diet":1,"allergens":802880,"minutes":25,"time":{"prep":25,"cook":0,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"12 small red Thai chiles, chopped","qty":""},{"item":"1 branch of lemongrass","qty":""},{"item":"3 cloves of garlic, pressed","qty":""},{"item":"1 small onion","qty":""},{"item":"1 tbsp grated ginger root","qty":""},{"item":"2 tbsp freshly chopped cilantro, leaves and stems","qty":""},{"item":"1 pinch of ground cumin","qty":""},{"item":"1 tbsp trassi (shrimp paste)","qty":""},{"item":"2 tbsp oil","qty":""}],"steps":["Grind the red chiles, garlic, lemongrass, and onion in a mortar.","Add the remaining ingredients except for the oil, and keep grinding to make a fluid paste.","Mix in the oil. Store in an airtight container in the refrigerator for up to 1 month."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":125,"era":"modern"}