{"id":"w214042","name":"Com Chien (Vietnamese Fried Rice)","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Com_Chien_(Vietnamese_Fried_Rice)"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Com_Chien_(Vietnamese_Fried_Rice)"},"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Com%20chien.jpg?width=640","cuisine":"Vietnamese","country":"","region":"Southeast Asia","course":"side","protein":"seafood","diet":0,"allergens":68,"minutes":30,"time":{"prep":20,"cook":10,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"5","difficulty":"easy","ingredients":[{"item":"3 tbsp oil","qty":""},{"item":"3 cloves garlic","qty":""},{"item":"2 leeks, chopped finely","qty":""},{"item":"2 red chiles, chopped finely","qty":""},{"item":"2 eggs, beaten","qty":""},{"item":"100 g diced carrot","qty":""},{"item":"200 g prawn, diced small","qty":""},{"item":"100 g green peas","qty":""},{"item":"600 g rice","qty":""},{"item":"1 tbsp salt","qty":""},{"item":"1 tbsp pepper","qty":""},{"item":"2 tbsp chicken powder","qty":""},{"item":"Fried egg","qty":""}],"steps":["Heat the oil in a non-stick pan, and stir-fry the garlic, red chile, and leeks for about 1 minute.","Add the prawn, carrot, and peas, and then add the beaten eggs. Mix until combined.","Add the rice, salt, pepper, and chicken powder. Stir until well-mixed.","Serves with a fried egg."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0"}