{"id":"m53245","name":"Noodle bowl salad","author":"bbcgoodfood.com","source":{"name":"bbcgoodfood.com","url":"https://www.bbcgoodfood.com/recipes/noodle-bowl-salad"},"via":{"name":"TheMealDB","url":"https://www.themealdb.com/meal/53245"},"image":"https://www.themealdb.com/images/media/meals/zry07j1763779321.jpg","cuisine":"Vietnamese","country":"Vietnam","region":"Southeast Asia","course":"main","protein":"seafood","diet":1,"allergens":433,"minutes":45,"time":{"prep":30,"cook":15,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"Rice Noodles","qty":"125 g"},{"item":"Sugar Snap Peas","qty":"200 g"},{"item":"Sesame Seed Oil","qty":"2 tsp"},{"item":"Spring Onions","qty":"4 sliced"},{"item":"Coriander","qty":"Handful"},{"item":"Hot Smoked Flaked Salmon","qty":"150 g"},{"item":"Pretzels","qty":"To serve"},{"item":"Soy Sauce","qty":"3 tbsp"},{"item":"Clear Honey","qty":"1 tbsp"},{"item":"Lemon Juice","qty":"1 tbsp"},{"item":"Ground Nut Oil","qty":"1 tbsp"},{"item":"Garlic","qty":"1 clove finely chopped"},{"item":"Ginger","qty":"Knob"}],"steps":["Drop the noodles into a large bowl, then pour over enough boiling water to cover. Tip in the sliced sugar snaps and leave for 4 minutes. Drain in a colander, put under cold running water to cool off, then drain again. Tip into a bowl and toss in the sesame oil.","Mix the dressing ingredients. Pile spring onions, coriander and salmon onto the noodles, pour over the dressing and toss everything together. Serve with a pretzel or bread roll."],"tags":[],"youtube":"https://www.youtube.com/watch?v=7EAdKeikJ9o","culture":null,"license":"TheMealDB"}