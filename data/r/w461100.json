{"id":"w461100","name":"Rhubarb Crumble II","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Rhubarb_Crumble_II"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Rhubarb_Crumble_II"},"image":"","cuisine":"","country":"","region":"Global","course":"main","protein":"veggie","diet":2,"allergens":131075,"minutes":80,"time":{"prep":20,"cook":60,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"1 cup brown sugar","qty":""},{"item":"¾ cup oats","qty":""},{"item":"1 cup flour","qty":""},{"item":"½ cup butter","qty":""},{"item":"1 tsp cinnamon","qty":""},{"item":"4 cup uncooked diced rhubarb","qty":""},{"item":"1 cup white sugar","qty":""},{"item":"2 tbsp corn starch","qty":""},{"item":"1 cup water","qty":""},{"item":"1 tsp vanilla","qty":""}],"steps":["Mix brown sugar, oats, flour, butter, and cinnamon until crumbly.","Press half the mixture into a 9 inch square pan.","Cover crumb mixture with diced rhubarb.","Mix white sugar, cornstarch, and water. Cook until clear and thick, stirring constantly. Add vanilla and stir.","Pour over rhubarb. Sprinkle with remaining crumb mixture over the top.","Bake for 1 hour at 180°C."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}