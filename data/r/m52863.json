{"id":"m52863","name":"Vegetarian Casserole","author":"bbcgoodfood.com","source":{"name":"bbcgoodfood.com","url":"https://www.bbcgoodfood.com/recipes/1993645/vegetarian-casserole"},"via":{"name":"TheMealDB","url":"https://www.themealdb.com/meal/52863"},"image":"https://www.themealdb.com/images/media/meals/vptwyt1511450962.jpg","cuisine":"British","country":"United Kingdom","region":"Europe","course":"main","protein":"veggie","diet":3,"allergens":0,"minutes":70,"time":{"prep":30,"cook":40,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"medium","ingredients":[{"item":"Rapeseed Oil","qty":"1"},{"item":"Onion","qty":"1"},{"item":"Garlic","qty":"3 cloves"},{"item":"Paprika","qty":"1 tsp"},{"item":"Cumin","qty":"½ tsp"},{"item":"Thyme","qty":"1 tbsp"},{"item":"Carrots","qty":"3 Medium"},{"item":"Celery","qty":"2 small stalks"},{"item":"Red Pepper","qty":"1"},{"item":"Yellow Pepper","qty":"1"},{"item":"Tomato","qty":"2 x 400 g tins"},{"item":"Vegetable Stock Cube","qty":"250 ml"},{"item":"Courgettes","qty":"2 sliced"},{"item":"Thyme","qty":"2 sprigs"},{"item":"Lentils","qty":"250 g"}],"steps":["Heat the oil in a large, heavy-based pan. Add the onions and cook gently for 5 – 10 mins until softened.","Add the garlic, spices, dried thyme, carrots, celery and peppers and cook for 5 minutes.","Add the tomatoes, stock, courgettes and fresh thyme and cook for 20 - 25 minutes.","Take out the thyme sprigs. Stir in the lentils and bring back to a simmer. Serve with wild and white basmati rice, mash or quinoa."],"tags":["Casserole","Vegetarian"],"youtube":"https://www.youtube.com/watch?v=oHmKE9mWtWM","culture":null,"license":"TheMealDB"}