{"id":"w252233","name":"Smoked Salmon Chowder","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Smoked_Salmon_Chowder"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Smoked_Salmon_Chowder"},"image":"","cuisine":"Native American","country":"","region":"Americas","course":"soup","protein":"seafood","diet":0,"minutes":30,"timeEstimated":true,"difficulty":"easy","ingredients":[{"item":"2 tbsp grape seed/safflower/canola oil","qty":""},{"item":"2 onions, chopped","qty":""},{"item":"4 celery stalks, chopped","qty":""},{"item":"2 carrots, chopped","qty":""},{"item":"1 tsp dried tarragon","qty":""},{"item":"3 potatoes, boiled and smashed","qty":""},{"item":"8 ounces smoked salmon, crumbled","qty":""},{"item":"½ gallon salmon/fish stock","qty":""},{"item":"½ gallon milk","qty":""},{"item":"1 tbsp black pepper","qty":""}],"steps":["Place stock pot over medium heat, add oil.","Add carrots, onions, celery, stirring until onions turn clear.","Add tarragon and salmon stock to deglaze bottom of pan.","Stir in smashed potatoes, smoked salmon. Continue to stir and bring to a simmer.","Add milk and pepper.","Serve and enjoy."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0"}