{"id":"w190089","name":"Banana Bread II","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Banana_Bread_II"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Banana_Bread_II"},"image":"","cuisine":"","country":"","region":"Global","course":"dessert","protein":"veggie","diet":2,"allergens":23,"minutes":90,"time":{"prep":25,"cook":35,"passive":30,"passiveWhy":["cooling"]},"timeEstimated":false,"servings":"","difficulty":"easy","ingredients":[{"item":"colspan=\"5\" style=\"text-align: center; background: #f5f5f5;\" |Component 1","qty":""},{"item":"Melted butter","qty":"½ cup / 113 g"},{"item":"White granulated sugar","qty":"1 cup / 200 g"},{"item":"Eggs","qty":"2 each. / 100 g"},{"item":"Vanilla extract","qty":"1 tsp / 4.2 g"},{"item":"Flour","qty":"1 ½ cups / 187 g"},{"item":"Baking soda","qty":"1 tsp / 4.6 g"},{"item":"Salt","qty":"½ tsp / 3 g"},{"item":"Sour cream","qty":"113 g (4 oz)"},{"item":"Sliced bananas (ripe)","qty":"2 each. / 162–304 g"},{"item":"Chopped walnuts (optional)","qty":"½ cup / 58.5 g"},{"item":"Ground cinnamon (optional)","qty":"1 tsp / 2.6 g"}],"steps":["Preheat oven to 350°F (~175°C)","Grease 9x5-inch (23x13 cm) loaf pan (optionally mix some sugar with a little cinnamon and spread over buttered surface of pan).","Beat eggs.","Mix melted butter and sugar in a large bowl (alternatively, cream the butter).","Stir in eggs and vanilla.","Combine flour, baking soda, salt, and cinnamon; add to mixture.","Add sour cream, sliced bananas, and walnuts.","Pour mixture into pan, optionally using a spatula to even out the top.","Bake for about 1 hour, let cool, and enjoy!"],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}