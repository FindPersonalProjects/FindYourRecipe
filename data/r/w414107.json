{"id":"w414107","name":"Nuremberg Gingerbread","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Nuremberg_Gingerbread"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Nuremberg_Gingerbread"},"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Lebkuchen-pile.jpg?width=640","cuisine":"German","country":"","region":"Europe","course":"dessert","protein":"veggie","diet":2,"allergens":17,"minutes":60,"time":{"prep":30,"cook":30,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"15","difficulty":"easy","ingredients":[{"item":"500 g honey","qty":""},{"item":"250 g granulated sugar","qty":""},{"item":"150 g flour","qty":""},{"item":"1 tsp cloves, ground","qty":""},{"item":"1 tsp nutmeg","qty":""},{"item":"1 tsp cardamom","qty":""},{"item":"1 tbsp cinnamon","qty":""},{"item":"1 pinch of ground ginger","qty":""},{"item":"Grated zest of 1 orange","qty":""},{"item":"Grated zest of 1 lemon","qty":""},{"item":"200 g chopped hazelnuts","qty":""},{"item":"50 g lemon flavoring","qty":""},{"item":"50 g orange flavoring","qty":""},{"item":"Gingerbread wafers","qty":""},{"item":"1 packet of baking powder","qty":""}],"steps":["Bring the honey and sugar to the boil in a saucepan while stirring. Remove from the heat and let cool.","Sift the flour into a bowl.","Stir in the remaining ingredients.","Pour the honey mixture, then the baking powder into the flour. Stir and knead the dough until it cools down.","Roll out the dough.","Cut out the dough, and place on the gingerbread wafers.","Decorate with an almond, and transfer to a baking sheet.","Let cool for about a day","Bake at 180 °C for 15–20 minutes"],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0"}