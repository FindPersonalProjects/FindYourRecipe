{"id":"hdesserts-ginger-pears","name":"Ginger pears","author":"The Wickham family","source":{"name":"Wickham family recipes","url":"https://github.com/hadley/recipes/blob/main/recipes/desserts/ginger-pears.md"},"via":{"name":"GitHub","url":"https://github.com/hadley/recipes"},"image":"","cuisine":"","country":"","region":"Global","course":"dessert","protein":"veggie","diet":2,"allergens":7,"minutes":65,"time":{"prep":25,"cook":40,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"medium","ingredients":[{"item":"2-3 pears peeled and cut into pieces","qty":""},{"item":"1 tsp butter","qty":""},{"item":"3 tsp golden syrup","qty":""},{"item":"100 g butter","qty":""},{"item":"1/2 cup brown sugar","qty":""},{"item":"2 tsp golden syrup","qty":""},{"item":"2 eggs lightly beaten","qty":""},{"item":"1 cup flour","qty":""},{"item":"1/2 tsp baking powder","qty":""},{"item":"1 tsp ground ginger","qty":""},{"item":"1 tsp cinnamon","qty":""},{"item":"pinch of nutmeg","qty":""},{"item":"salt to taste","qty":""}],"steps":["Preheat oven to 180 C.","Warm the first measure of butter and golden syrup in a 20cm baking tin.","Arrange the pear pieces in tin.","Cream the butter, brown sugar and golden syrup.","Gradually add the lightly beaten eggs to the creamed mixture.","Sift dry ingredients and fold into creamed mixture.","Spread mixture carefully over pears.","Bake 180 C 35-40 minutes.","Invert the tin onto plate to serve.","Drained tinned pears may be used on place of fresh pears."],"tags":[],"youtube":"","culture":null,"license":"CC BY 4.0","era":"modern","vintage":null,"lifestyle":3}