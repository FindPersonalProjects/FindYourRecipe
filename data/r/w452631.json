{"id":"w452631","name":"Coconut Rice (Indonesian)","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Coconut_Rice_(Indonesian)"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Coconut_Rice_(Indonesian)"},"image":"","cuisine":"Indonesian","country":"","region":"Southeast Asia","course":"main","protein":"veggie","diet":3,"allergens":0,"minutes":60,"time":{"prep":15,"cook":30,"passive":15,"passiveWhy":["resting"]},"timeEstimated":true,"servings":"4","difficulty":"easy","ingredients":[{"item":"300 g uncooked white long-grain rice","qty":""},{"item":"400 ml coconut milk","qty":""},{"item":"2 red shallots","qty":""},{"item":"2 slices fresh ginger","qty":""},{"item":"1 pinpoint of fenugreek seed","qty":""},{"item":"2 pandan leaves","qty":""}],"steps":["Rinse and drain the rice.","Put all ingredients in a skillet or saucepan; make sure the rice is submerged in the coconut milk by 2 cm.","Cover the pan and allow to cook over medium-low heat until the liquid is absorbed.","Remove the pandan leaves.","Pour the rest of the coconut milk over the rice.","Allow to rest for 15 minutes at room temperature, then serve."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0"}