{"id":"w38951","name":"Banana Nut Muffins","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Banana_Nut_Muffins"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Banana_Nut_Muffins"},"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Banana-Nut-Muffins-2005-Aug-24.jpg?width=640","cuisine":"","country":"","region":"Global","course":"main","protein":"veggie","diet":2,"allergens":8343,"minutes":40,"time":{"prep":20,"cook":20,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"","difficulty":"easy","ingredients":[{"item":"2 eggs","qty":""},{"item":"1 tbsp honey, molasses, or sugar","qty":""},{"item":"1 cup milk (or soy milk)","qty":""},{"item":"¼ cup vegetable oil","qty":""},{"item":"2–3 bananas, mashed","qty":""},{"item":"⅔ cups (160 ml) white flour","qty":""},{"item":"1⅓ cups (320 g) whole wheat flour","qty":""},{"item":"½ tsp salt","qty":""},{"item":"2 tsp baking powder","qty":""},{"item":"½ cups (120 ml) chopped nuts (such as walnuts)","qty":""},{"item":"Sugar to taste, if necessary","qty":""}],"steps":["Preheat oven to 400°F (200°C).","Grease a muffin tin.","Cream together eggs, honey, milk, vegetable oil, and bananas.","Combine dry ingredients, then mix gently with wet ingredients. Lumpy batter is to be expected.","Bake for 20–25 minutes.","Cool."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}