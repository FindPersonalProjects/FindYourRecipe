{"id":"w143842","name":"Cincinnati-Style Chili","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Cincinnati-Style_Chili"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Cincinnati-Style_Chili"},"image":"","cuisine":"","country":"","region":"Global","course":"main","protein":"beef","diet":0,"allergens":1859616,"minutes":155,"time":{"prep":35,"cook":120,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"2 pounds ground beef","qty":""},{"item":"1 quart cold water","qty":""},{"item":"1 can (6 ounces) tomato paste","qty":""},{"item":"2 medium onions, finely chopped","qty":""},{"item":"2 cloves of garlic, minced","qty":""},{"item":"1 tbsp vinegar","qty":""},{"item":"1 tsp Worcestershire sauce","qty":""},{"item":"3 tbsp chili powder","qty":""},{"item":"1 tbsp salt","qty":""},{"item":"1 tsp cumin","qty":""},{"item":"½ tsp oregano","qty":""},{"item":"½ tsp cayenne pepper","qty":""},{"item":"½ tsp black pepper","qty":""},{"item":"½ tsp cinnamon","qty":""},{"item":"½ tsp allspice","qty":""},{"item":"¼ tsp marjoram","qty":""},{"item":"⅛ tsp ground cloves","qty":""},{"item":"2 bay leaves","qty":""}],"steps":["Crumble the raw ground beef into the cold water.","Add remaining ingredients and spices. Stir well, breaking the meat up before cooking.","Cover and simmer over low heat for two hours, stirring occasionally.","Cool, then refrigerate and remove solidified grease.","Reheat and serve as desired."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":127,"era":"modern"}