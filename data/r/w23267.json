{"id":"w23267","name":"Oven Pancakes","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Oven_Pancakes"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Oven_Pancakes"},"image":"","cuisine":"","country":"","region":"Global","course":"breakfast","protein":"veggie","diet":2,"allergens":8195,"minutes":40,"time":{"prep":20,"cook":20,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"1 cup (150 g) all-purpose flour","qty":""},{"item":"2 tsp baking powder","qty":""},{"item":"½ tsp baking soda","qty":""},{"item":"½ tsp salt","qty":""},{"item":"2 tbsp sugar","qty":""},{"item":"1 cup (250 ml) milk","qty":""},{"item":"2 tbsp vegetable oil","qty":""},{"item":"2 tsp vanilla","qty":""},{"item":"1 tbsp apple cider vinegar","qty":""}],"steps":["Preheat oven to 232°C (450°F), and oil an 8-inch oven-safe skillet.","Combine flour, baking powder, baking soda, salt, and sugar.","Add the milk, oil, and vanilla; stir well.","Stir in the apple cider vinegar, mix well, and pour immediately into the skillet.","Bake at 232°C (450°F) for 18 to 20 minutes, and serve."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}