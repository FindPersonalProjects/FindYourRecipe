{"id":"hdesserts-christmas-pudding-rich","name":"Christmas pudding, rich","author":"The Wickham family","source":{"name":"Wickham family recipes","url":"https://github.com/hadley/recipes/blob/main/recipes/desserts/christmas-pudding-rich.md"},"via":{"name":"GitHub","url":"https://github.com/hadley/recipes"},"image":"","cuisine":"","country":"","region":"Global","course":"dessert","protein":"veggie","diet":2,"allergens":9239,"minutes":395,"time":{"prep":35,"cook":360,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"hard","ingredients":[{"item":"2 oz flour","qty":""},{"item":"2 oz soft breadcrumbs","qty":""},{"item":"4 oz brown sugar","qty":""},{"item":"1 oz chopped almonds","qty":""},{"item":"1 1/2 tsp rum or brandy","qty":""},{"item":"4 oz butter","qty":""},{"item":"4 oz sultanas","qty":""},{"item":"2 oz currants","qty":""},{"item":"1 oz chopped candied peel","qty":""},{"item":"4 oz raisins","qty":""},{"item":"2 eggs","qty":""},{"item":"1/8 tsp salt","qty":""},{"item":"1/8 tsp nutmeg","qty":""},{"item":"1/8 tsp mixed spice","qty":""},{"item":"1/8 tsp ginger","qty":""},{"item":"1/8 tsp cinnamon","qty":""},{"item":"1/8 tsp baking powder","qty":""}],"steps":["Sprinkle fruit with brandy and soak over night.","Cream butter and sugar.","Gradually add beaten eggs, beating constantly.","Stir in sifted dry ingredients, add bread crumbs alternately with fruit and nuts.","Put into large lined and greased basin.","Cover with aluminum foil and tie on with string.","Sit on a trivet in a large saucepan and add boiling water 2/3 up the sides of the bowl.","Place the lid on the pan.","Steam for 6 hours checking occasionally and topping up with boiling water.","Comments: Big enough for eight.","Very rich and delicous."],"tags":[],"youtube":"","culture":null,"license":"CC BY 4.0","era":"modern","vintage":null,"lifestyle":2}