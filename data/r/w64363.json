{"id":"w64363","name":"Oven Pancakes (Vegan)","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Oven_Pancakes_(Vegan)"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Oven_Pancakes_(Vegan)"},"image":"","cuisine":"","country":"","region":"Global","course":"breakfast","protein":"veggie","diet":3,"allergens":8321,"minutes":40,"time":{"prep":20,"cook":20,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"1 cup (236 ml) flour","qty":""},{"item":"2 tsp baking powder","qty":""},{"item":"½ tsp baking soda","qty":""},{"item":"½ tsp salt","qty":""},{"item":"2 tbsp white granulated sugar","qty":""},{"item":"1 cup (236 ml) soy milk","qty":""},{"item":"2 tbsp vegetable oil","qty":""},{"item":"2 tsp vanilla","qty":""},{"item":"1 tbsp apple cider vinegar","qty":""}],"steps":["Preheat oven to 230 C and oil an 8-inch oven-safe skillet.","Combine flour, baking powder, baking soda, salt, and sugar.","Add the soy milk, vegetable oil, and vanilla; stir well.","Stir in the apple cider vinegar, mix well, and pour immediately into the skillet.","Bake at 230 C for 18 to 20 minutes, and serve."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}