{"id":"w453111","name":"Sindhi Spiced Moong Dal","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Sindhi_Spiced_Moong_Dal"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Sindhi_Spiced_Moong_Dal"},"image":"","cuisine":"","country":"","region":"Global","course":"main","protein":"veggie","diet":3,"allergens":540672,"minutes":100,"time":{"prep":15,"cook":25,"passive":60,"passiveWhy":["soaking"]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"200 g yellow moong dal","qty":""},{"item":"4 green chiles","qty":""},{"item":"8–10 g fresh whole ginger","qty":""},{"item":"Salt to taste","qty":""},{"item":"1 pinch coriander powder","qty":""},{"item":"1 tbsp ground pepper","qty":""},{"item":"1 pinch red chile powder","qty":""},{"item":"Oil","qty":""}],"steps":["Soak the dal in water for 1 hour. Drain.","Combine the dal, chiles, and ginger in a pot. Do not add salt.","Cover the dal with water. Boil in a pressure cooker for at least 3–4 minutes.","Transfer the dal to a bowl. Season with salt, coriander, and pepper.","Sprinkle with chili powder, and drizzle with some oil."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":71,"era":"modern"}