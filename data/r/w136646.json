{"id":"w136646","name":"Thai Green Curry Paste","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Thai_Green_Curry_Paste"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Thai_Green_Curry_Paste"},"image":"","cuisine":"Thai","country":"","region":"Southeast Asia","course":"main","protein":"veggie","diet":2,"minutes":30,"timeEstimated":true,"difficulty":"easy","ingredients":[{"item":"16 green piri-piri chilli-peppers, chopped","qty":""},{"item":"2 branches lemongrass, smashed","qty":""},{"item":"3 cloves garlic, pressed","qty":""},{"item":"3 scallions, chopped","qty":""},{"item":"1 tablespoon grated ginger root","qty":""},{"item":"1 tablespoon coriander seed","qty":""},{"item":"1 tablespoon caraway seed","qty":""},{"item":"4 whole cloves","qty":""},{"item":"1 tablespoon nutmeg","qty":""},{"item":"1 tablespoon trassi","qty":""},{"item":"3 tablespoons oil","qty":""}],"steps":["Grind the green chilli peppers, garlic, lemongrass, and scallions in a mortar.","Add the remaining ingredients except for the oil, and keep grinding to a fluid paste.","Mix in the oil.","Store in an airtight container in the refrigerator for up to 1 month."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0"}