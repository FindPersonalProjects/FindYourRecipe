{"id":"w62476","name":"Oatmeal Muffins","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Oatmeal_Muffins"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Oatmeal_Muffins"},"image":"","cuisine":"","country":"","region":"Global","course":"main","protein":"veggie","diet":2,"allergens":65543,"minutes":25,"time":{"prep":10,"cook":15,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"12","difficulty":"easy","ingredients":[{"item":"1 cup (240 ml) rolled oats","qty":""},{"item":"1 cup (240 ml) cultured buttermilk","qty":""},{"item":"1 egg","qty":""},{"item":"¼ cup (60 ml) margarine","qty":""},{"item":"1 cup (240 ml) all-purpose flour","qty":""},{"item":"1 tsp baking powder","qty":""},{"item":"½ tsp baking soda","qty":""},{"item":"¼ tsp salt","qty":""},{"item":"¾ cup (180 ml) brown sugar","qty":""},{"item":"¼ cup (60 ml) coconut","qty":""}],"steps":["Stir rolled oats and buttermilk together in a mixing bowl.","Combine flour, coconut, brown sugar, baking powder, baking soda, and salt in another mixing bowl. Stir together to mix. Make a well in the center.","Add egg and margarine to oat mixture. Mix well.","Pour all at once into flour mixture. Stir just to moisten.","Fill muffin cups ¾ full.","Bake at 400°F (200°C) for 15–20 minutes."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}