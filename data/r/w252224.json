{"id":"w252224","name":"Halibut Cheek Stir-Fry","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Halibut_Cheek_Stir-Fry"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Halibut_Cheek_Stir-Fry"},"image":"","cuisine":"","country":"","region":"Global","course":"main","protein":"seafood","diet":1,"allergens":266409,"minutes":60,"time":{"prep":30,"cook":30,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"5","difficulty":"medium","ingredients":[{"item":"1 Tbsp peanut oil","qty":""},{"item":"1 lb (450 g) halibut cheeks","qty":""},{"item":"2 Tbsp chopped carrots","qty":""},{"item":"2 Tbsp chopped celery","qty":""},{"item":"1 Tbsp chopped fresh ginger","qty":""},{"item":"1 Tbsp chopped garlic","qty":""},{"item":"2 Tbsp chopped green onions","qty":""},{"item":"1 Tbsp reduced sodium soy sauce","qty":""},{"item":"1 Tbsp fish stock","qty":""},{"item":"1 Tbsp black pepper","qty":""}],"steps":["Add oil to wok or frying pan over medium-high heat.","Add halibut cheeks, moving around in oil until they start to brown.","Add carrots and celery, stirring them around in the wok.","Add ginger and garlic, while continuing to stir.","Add soy sauce and fish stock. Stir and bring to simmer.","Garnish with green onions.","Serve and enjoy."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":71,"era":"modern"}