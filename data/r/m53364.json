{"id":"m53364","name":"Jamaican Steamed Cabbage","author":"myforkinglife.com","source":{"name":"myforkinglife.com","url":"https://www.myforkinglife.com/jamaican-cabbage/#recipe"},"via":{"name":"TheMealDB","url":"https://www.themealdb.com/meal/53364"},"image":"https://www.themealdb.com/images/media/meals/paejva1765321314.jpg","cuisine":"Jamaican","country":"Jamaica","region":"Americas","course":"side","protein":"veggie","diet":1,"minutes":60,"timeEstimated":true,"difficulty":"medium","ingredients":[{"item":"Cabbage","qty":"1/2"},{"item":"Carrots","qty":"2 sliced"},{"item":"Plum Tomatoes","qty":"1 chopped"},{"item":"Onion","qty":"1 chopped"},{"item":"Garlic","qty":"4 Cloves Chopped"},{"item":"Spring Onions","qty":"4 Chopped"},{"item":"Thyme","qty":"4 sprigs"},{"item":"Scotch Bonnet","qty":"1/2"},{"item":"Water","qty":"2 tablespoons"},{"item":"Olive Oil","qty":"2 tablespoons"},{"item":"Unsalted Butter","qty":"4 tablespoons"},{"item":"Kosher Salt","qty":"2 tsp"},{"item":"Black Pepper","qty":"1 tsp"}],"steps":["Add all the ingredients to a large pan over medium heat and cover with a lid.","Cook on medium heat for 10 minutes, stirring occasionally.","After 10 minutes, reduce the heat to low and continue to cook for an additional 5 minutes, until the cabbage is soft and tender. Remove from the heat and remove the stalks of thyme before serving."],"tags":[],"youtube":"https://www.youtube.com/watch?v=amEkrC9rzgM","culture":null,"license":"TheMealDB"}