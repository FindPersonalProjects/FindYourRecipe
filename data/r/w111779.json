{"id":"w111779","name":"Pork Braised with Garlic and Onions of Indonesia (Babi Kecap)","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Pork_Braised_with_Garlic_and_Onions_of_Indonesia_(Babi_Kecap)"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Pork_Braised_with_Garlic_and_Onions_of_Indonesia_(Babi_Kecap)"},"image":"","cuisine":"Indonesian","country":"","region":"Southeast Asia","course":"main","protein":"pork","diet":0,"allergens":641,"minutes":45,"time":{"prep":20,"cook":25,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"6","difficulty":"medium","ingredients":[{"item":"1 kg pork","qty":""},{"item":"5 large white onions, chopped","qty":""},{"item":"5 cloves garlic, minced","qty":""},{"item":"4 tsp soy sauce","qty":""},{"item":"Fresh ginger","qty":""},{"item":"Black pepper","qty":""},{"item":"Chile pepper (optional)","qty":""}],"steps":["Cut the meat into 1-inch (2.5 cm) cubes.","Add the onions, garlic and ginger to a pan and cook at around 200°C.","Add the pork and mix with the soy sauce and black pepper (and chili pepper if desired).","After about 3–4 minutes, reduce the heat to around 120°C and cook, covered, for one hour.","Serve with nice-tasting rice."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0"}