{"id":"m52818","name":"Chicken Fajita Mac and Cheese","author":"twistedfood.co.uk","source":{"name":"twistedfood.co.uk","url":"http://twistedfood.co.uk/chicken-fajita-mac-n-cheese/"},"via":{"name":"TheMealDB","url":"https://www.themealdb.com/meal/52818"},"image":"https://www.themealdb.com/images/media/meals/qrqywr1503066605.jpg","cuisine":"American","country":"United States","region":"Americas","course":"main","protein":"poultry","diet":0,"minutes":55,"timeEstimated":true,"difficulty":"medium","ingredients":[{"item":"macaroni","qty":"500g"},{"item":"chicken stock","qty":"2 cups"},{"item":"heavy cream","qty":"1/2 cup"},{"item":"fajita seasoning","qty":"1 packet"},{"item":"salt","qty":"1 tsp"},{"item":"chicken breast","qty":"3 diced"},{"item":"olive oil","qty":"2 tbsp"},{"item":"onion","qty":"1 small finely diced"},{"item":"red pepper","qty":"2 finely diced"},{"item":"garlic","qty":"2 cloves minced"},{"item":"cheddar cheese","qty":"1 cup"},{"item":"parsley","qty":"garnish chopped"}],"steps":["Fry your onion, peppers and garlic in olive oil until nicely translucent. Make a well in your veg and add your chicken. Add your seasoning and salt. Allow to colour slightly.","Add your cream, stock and macaroni.","Cook on low for 20 minutes. Add your cheeses, stir to combine.","Top with roasted peppers and parsley."],"tags":["Pasta","Cheasy","Meat","Cheesy"],"youtube":"https://www.youtube.com/watch?v=bwTSmLTZKNg","culture":null,"license":"TheMealDB"}