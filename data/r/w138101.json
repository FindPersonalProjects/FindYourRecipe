{"id":"w138101","name":"Corn Chowder I","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Corn_Chowder_I"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Corn_Chowder_I"},"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Corn%20chowder%20bowl.jpg?width=640","cuisine":"Native American","country":"","region":"Americas","course":"soup","protein":"poultry","diet":0,"allergens":413698,"minutes":60,"time":{"prep":30,"cook":30,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"6","difficulty":"easy","ingredients":[{"item":"2 tbsp butter or margarine","qty":""},{"item":"1 cup chopped onion","qty":""},{"item":"½ cup chopped celery","qty":""},{"item":"1½ cups diced, pared potatoes, cut in ½-inch cubes","qty":""},{"item":"2 cups corn, fresh or frozen","qty":""},{"item":"1½ cups water","qty":""},{"item":"2 chicken bouillon cubes","qty":""},{"item":"¼ tsp thyme","qty":""},{"item":"1 cup milk","qty":""},{"item":"1 cup light cream","qty":""},{"item":"Salt to taste","qty":""},{"item":"Pepper to taste","qty":""}],"steps":["In a medium saucepan, melt butter; add onion and celery and cook until tender.","Add potatoes, corn, salt, pepper, water, bouillon cubes, and thyme.","Cover and simmer for 15 minutes, or until potatoes and corn are tender.","Add milk and cream.","Heat through."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":65,"era":"modern"}