{"id":"w70189","name":"Chess Pie","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Chess_Pie"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Chess_Pie"},"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Baked%20chess%20pie.jpg?width=640","cuisine":"","country":"","region":"Global","course":"dessert","protein":"veggie","diet":2,"allergens":8198,"minutes":35,"time":{"prep":10,"cook":25,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"8","difficulty":"easy","ingredients":[{"item":"2.5 cups (600 g) white sugar","qty":""},{"item":"3 eggs","qty":""},{"item":"1 tbsp vinegar","qty":""},{"item":"1 tsp vanilla","qty":""},{"item":"1 stick (4 oz / 113 g) butter","qty":""},{"item":"9-inch (22 cm) pre-made pie crust","qty":""}],"steps":["Preheat oven to 375°F (190°C).","Mix sugar, butter, and vinegar in saucepan. Bring to a boil.","Beat eggs in bowl.","Gradually whisk the saucepan contents into the eggs, then add vanilla.","Pour mixture into pie crust.","Bake pie in 375°F (190°C) oven for 35 minutes.","Let cool."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}