{"id":"w109475","name":"Sausage-Egg Breakfast Dish","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Sausage-Egg_Breakfast_Dish"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Sausage-Egg_Breakfast_Dish"},"image":"","cuisine":"","country":"","region":"Global","course":"breakfast","protein":"pork","diet":0,"allergens":1065479,"minutes":180,"time":{"prep":15,"cook":105,"passive":60,"passiveWhy":["freezing"]},"timeEstimated":false,"servings":"6–8","difficulty":"easy","ingredients":[{"item":"1 package (16 ounces) of sage-flavored sausage","qty":""},{"item":"Pinch of pepper","qty":""},{"item":"6 eggs","qty":""},{"item":"1½ cups milk","qty":""},{"item":"4 cups cubed stale bread","qty":""},{"item":"4 ounces shredded cheddar cheese","qty":""}],"steps":["Brown sausage and sprinkle with pepper.","Drain off excess fat, and let sausage cool.","Beat eggs and add milk.","Fold in cubes of stale bread, cheese, and cooled sausage.","Pour into and 8 by 8-inch baking dish coated with cooking spray.","Refrigerate for at least an hour (or freeze for later).","Preheat oven to 325°F. Bake for 1 hour.","Cool and cut into squares."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":64,"era":"modern"}