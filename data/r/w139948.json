{"id":"w139948","name":"Poppyseed Chicken","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Poppyseed_Chicken"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Poppyseed_Chicken"},"image":"","cuisine":"","country":"","region":"Global","course":"main","protein":"poultry","diet":0,"allergens":7,"minutes":45,"time":{"prep":20,"cook":25,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"4–6","difficulty":"easy","ingredients":[{"item":"4 pieces of chicken breast, boiled and diced","qty":""},{"item":"1 cup mayonnaise (light or fat-free works)","qty":""},{"item":"1 cup sour cream (recommend light)","qty":""},{"item":"1 cup grated cheddar cheese","qty":""},{"item":"2 cups (about 1 sleeve) crushed Ritz crackers (or similar)","qty":""},{"item":"3 tbsp poppy seeds","qty":""},{"item":"1 stick butter or margarine, melted","qty":""}],"steps":["Preheat oven to 350°F (175°C).","Mix chicken with mayonnaise and sour cream. Spread this in the bottom of a 9x13 inch casserole dish.","Sprinkle cheese, crackers, then poppy seeds on top.","Evenly pour melted butter on top.","Bake at 350°F (175°C) for 25 minutes."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":65,"era":"modern"}