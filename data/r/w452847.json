{"id":"w452847","name":"Egg Noodles II","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Egg_Noodles_II"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Egg_Noodles_II"},"image":"","cuisine":"","country":"","region":"Global","course":"main","protein":"pasta","diet":2,"allergens":16389,"minutes":45,"time":{"prep":15,"cook":30,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"3 egg yolks","qty":""},{"item":"1 whole egg","qty":""},{"item":"1 tsp salt","qty":""},{"item":"1 dash pepper","qty":""},{"item":"80 ml (¼ cup) water","qty":""},{"item":"580 ml (2 cups) flour","qty":""},{"item":"1–2 tsp olive oil","qty":""}],"steps":["In a bowl, beat together egg yolks, egg, salt, and pepper.","Stir in water, then flour.","Knead into ball.","Roll out on a floured surface until 2–4 mm (1/16–⅛ inch) thick.","Cut into noodles 6 mm (¼ inch) wide.","Bring water to a boil in a pot, and add oil.","Add noodles to boiling water, and cook until done."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":67,"era":"modern"}