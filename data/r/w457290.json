{"id":"w457290","name":"Roasted Spiced Chicken Drumsticks","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Roasted_Spiced_Chicken_Drumsticks"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Roasted_Spiced_Chicken_Drumsticks"},"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Barbecued%20chicken%20drumsticks-01.jpg?width=640","cuisine":"","country":"","region":"Global","course":"main","protein":"poultry","diet":0,"allergens":802816,"minutes":40,"time":{"prep":15,"cook":25,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"4","difficulty":"medium","ingredients":[{"item":"1½ tsp paprika","qty":""},{"item":"1 tsp onion powder","qty":""},{"item":"½ tsp chilli powder","qty":""},{"item":"1 tsp salt","qty":""},{"item":"1 tsp olive oil","qty":""},{"item":"6 chicken drumsticks","qty":""}],"steps":["Combine the paprika, onion powder, chili powder, and salt together in a bowl.","Preheat oven to 400°F.","Pat the chicken dry with paper towels.","Coat the chicken with oil and the prepared spice blend, ensuring all sides are well-coated. Transfer to a baking dish.","Bake the chicken drumsticks until the skin is brown and crispy (about 25 minutes).","Serve hot."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":127,"era":"modern"}