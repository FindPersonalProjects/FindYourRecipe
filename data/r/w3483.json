{"id":"w3483","name":"Black-Eyed Peas and Kale","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Black-Eyed_Peas_and_Kale"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Black-Eyed_Peas_and_Kale"},"image":"","cuisine":"","country":"","region":"Global","course":"side","protein":"veggie","diet":3,"allergens":802816,"minutes":30,"time":{"prep":15,"cook":15,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"4","difficulty":"easy","ingredients":[{"item":"1 tbsp olive oil","qty":""},{"item":"2 cloves garlic, chopped","qty":""},{"item":"1 medium onion, chopped","qty":""},{"item":"1 can (15 oz) diced tomatoes, undrained","qty":""},{"item":"1 can (15 oz) black-eyed peas, drained","qty":""},{"item":"¼–½ tsp cayenne pepper","qty":""},{"item":"1 bay leaf","qty":""},{"item":"1 package (10 oz) frozen kale, thawed","qty":""},{"item":"Salt to taste","qty":""},{"item":"Pepper to taste","qty":""}],"steps":["Sauté the onion and garlic in the oil over medium heat for several minutes.","Add tomatoes and their juice, peas, cayenne and bay leaf. Simmer, covered, for 15 minutes.","Add kale and simmer uncovered until kale is tender but still green (5–10 minutes). Season to taste with salt and freshly-ground black pepper."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":71,"era":"modern"}