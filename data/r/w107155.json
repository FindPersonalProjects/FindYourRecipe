{"id":"w107155","name":"Lemon Sponge","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Lemon_Sponge"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Lemon_Sponge"},"image":"","cuisine":"","country":"","region":"Global","course":"dessert","protein":"veggie","diet":2,"allergens":7,"minutes":60,"time":{"prep":15,"cook":45,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"4","difficulty":"medium","ingredients":[{"item":"1 cup (225 g/7.9 oz) granulated sugar","qty":""},{"item":"3 tbsp flour","qty":""},{"item":"1 lemon, zested and juiced","qty":""},{"item":"2 eggs, separated","qty":""},{"item":"1 tbsp butter","qty":""},{"item":"1 pinch of salt","qty":""},{"item":"1 cup (250 ml/8.5 oz) milk","qty":""}],"steps":["Lightly beat egg yolks.","Mix the sugar and flour together, then add the lemon juice and zest, yolks, butter and salt.","Stir in the milk and mix well.","Whip the egg whites until stiff and fold into the first mixture.","Pour batter into custard cups or ramekins.","Set the cups in a pan of hot water and bake at 350 F for about 40 minutes."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}