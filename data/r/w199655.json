{"id":"w199655","name":"Pork Roast with Cayenne Apple Glaze","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Pork_Roast_with_Cayenne_Apple_Glaze"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Pork_Roast_with_Cayenne_Apple_Glaze"},"image":"","cuisine":"","country":"","region":"Global","course":"main","protein":"pork","diet":0,"allergens":1601056,"minutes":60,"time":{"prep":20,"cook":30,"passive":10,"passiveWhy":["resting"]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"2 boneless pork loin roasts","qty":""},{"item":"¼ cup Dijon mustard","qty":""},{"item":"6 oz apple cider","qty":""},{"item":"2 tbsp cider vinegar","qty":""},{"item":"2 tbsp brown sugar","qty":""},{"item":"2 tbsp Worcestershire sauce","qty":""},{"item":"1 tbsp cayenne pepper","qty":""},{"item":"1 tbsp salt","qty":""},{"item":"1 tbsp black pepper","qty":""},{"item":"1 tbsp smoked paprika","qty":""}],"steps":["Combine dry powders. Set aside.","Smear mustard as needed on one end of each roast. Attach mustard ends of roasts together.","Spread remaining mustard all over roasts. Apply dry powder mixture.","Bake at 375°F until internal temperature reaches 135°F.","Combine remaining ingredients and brush onto pork.","Bake at 375°F until internal temperature reaches 145°F (yes, it is safe).","Let rest for 10 minutes; serve."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":0,"era":"modern"}