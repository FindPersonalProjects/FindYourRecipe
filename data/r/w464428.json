{"id":"w464428","name":"Halo-Halo (Filipino Layered Dessert)","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Halo-Halo_(Filipino_Layered_Dessert)"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Halo-Halo_(Filipino_Layered_Dessert)"},"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Halo-Halo.jpg?width=640","cuisine":"Filipino","country":"","region":"Southeast Asia","course":"dessert","protein":"veggie","diet":2,"allergens":65538,"minutes":20,"time":{"prep":20,"cook":0,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"1½ cup shaved ice","qty":""},{"item":"½ cup chickpeas in syrup","qty":""},{"item":"½ cup red mung beans in syrup","qty":""},{"item":"⅓ cup nata de coco (coconut gel in syrup)","qty":""},{"item":"¼ cup kaong in syrup","qty":""},{"item":"1 tbsp ube jam (sweet purple yam paste)","qty":""},{"item":"2 scoops ube ice cream","qty":""},{"item":"2 each. 2 inch cubes leche flan","qty":""},{"item":"½ cup evaporated milk","qty":""},{"item":"Pinipig (toasted flattened rice), for serving (optional)","qty":""}],"steps":["Cover the bottoms of two serving bowls or glasses with a layer of shaved ice.","Top the ice with the chickpeas, mung beans, nata de coco, kaong, and ube jam.","Top with ube ice cream and leche flan, then pour the evaporated milk over everything.","Sprinkle with pinipig, if using."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}