{"id":"m53236","name":"Vietnamese-style veggie hotpot","author":"bbcgoodfood.com","source":{"name":"bbcgoodfood.com","url":"https://www.bbcgoodfood.com/recipes/vietnamese-veggie-hotpot"},"via":{"name":"TheMealDB","url":"https://www.themealdb.com/meal/53236"},"image":"https://www.themealdb.com/images/media/meals/4uje7l1763762276.jpg","cuisine":"Vietnamese","country":"Vietnam","region":"Southeast Asia","course":"main","protein":"veggie","diet":3,"allergens":129,"minutes":50,"time":{"prep":30,"cook":20,"passive":0,"passiveWhy":[]},"timeEstimated":true,"servings":"","difficulty":"easy","ingredients":[{"item":"Vegetable Oil","qty":"2 tsp"},{"item":"Ginger","qty":"4cm finely chopped"},{"item":"Garlic Clove","qty":"2 chopped"},{"item":"Butternut Squash","qty":"1/2"},{"item":"Soy Sauce","qty":"2 tsp"},{"item":"Brown Sugar","qty":"2 tsp"},{"item":"Vegetable Stock","qty":"200 ml"},{"item":"Green Beans","qty":"100 g shredded"},{"item":"Spring Onions","qty":"4 sliced"},{"item":"Coriander Leaves","qty":"To serve"},{"item":"Jasmine Rice","qty":"To serve"}],"steps":["Heat the oil in a medium-size, lidded saucepan. Add the ginger and garlic, then stir-fry for about 5 mins. Add the squash, soy sauce, sugar and stock. Cover, then simmer for 10 mins. Remove the lid, add the green beans, then cook for 3 mins more until the squash and beans are tender. Stir the spring onions through at the last minute, then sprinkle with coriander and serve with rice."],"tags":[],"youtube":"https://www.youtube.com/watch?v=OR6jC9gw_Hw","culture":null,"license":"TheMealDB"}