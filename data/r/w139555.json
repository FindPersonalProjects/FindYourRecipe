{"id":"w139555","name":"Pumpkin Bread III","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Pumpkin_Bread_III"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Pumpkin_Bread_III"},"image":"","cuisine":"","country":"","region":"Global","course":"breakfast","protein":"veggie","diet":2,"allergens":21,"minutes":60,"time":{"prep":20,"cook":40,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"","difficulty":"easy","ingredients":[{"item":"1½ cups white granulated sugar","qty":""},{"item":"1 cup oil","qty":""},{"item":"3 eggs, beaten","qty":""},{"item":"1 can (15 ounces) pumpkin purée","qty":""},{"item":"3 cups flour","qty":""},{"item":"¾ tsp baking powder","qty":""},{"item":"1 tsp baking soda","qty":""},{"item":"1 tsp cinnamon","qty":""},{"item":"½ tsp cloves","qty":""},{"item":"½ tsp ground nutmeg","qty":""},{"item":"¾ tsp salt","qty":""},{"item":"½ cup chopped nuts","qty":""},{"item":"Cooking spray","qty":""}],"steps":["Preheat oven to 350°F.","Beat sugar and oil using electric hand mixer.","Add eggs and pumpkin and beat lightly.","Add flour, then baking powder, baking soda, cinnamon, cloves, nutmeg, salt, and nuts if desired. Mix well.","Pour into two baking pans sprayed lightly with cooking spray.","Bake until toothpick comes out clean from the center, about 40–45 minutes.","Cool and serve."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}