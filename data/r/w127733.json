{"id":"w127733","name":"Fisherman\u0027s Casserole","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Fisherman\u0027s_Casserole"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Fisherman\u0027s_Casserole"},"image":"","cuisine":"","country":"","region":"Global","course":"side","protein":"seafood","diet":1,"allergens":268323,"minutes":60,"time":{"prep":20,"cook":40,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"8","difficulty":"easy","ingredients":[{"item":"1 package (8 ounces) macaroni","qty":""},{"item":"½ pound grated cheddar cheese","qty":""},{"item":"⅔ cup milk","qty":""},{"item":"½ tsp dry mustard","qty":""},{"item":"½ cup chopped onion","qty":""},{"item":"1 can (10¾ ounces) cream of celery soup","qty":""},{"item":"1 tsp salt","qty":""},{"item":"1 can (14¾ ounces) salmon","qty":""},{"item":"1 bag (8 ounces) frozen peas","qty":""},{"item":"1 cup bread crumbs","qty":""},{"item":"2 tbsp butter, melted","qty":""}],"steps":["Preheat oven to 350°F (175°C).","Cook macaroni according to package directions; drain.","In a large bowl, combine cheese, macaroni, milk, dry mustard, onion, soup, and salt.","Add salmon and frozen peas.","Place in a greased 9 x 13-inch pan.","Cover mixture with bread crumbs; drizzle with melted butter.","Bake for 45 minutes."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":67,"era":"modern"}