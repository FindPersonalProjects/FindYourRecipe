{"id":"w39444","name":"Almond Fudge Brownies","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Almond_Fudge_Brownies"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Almond_Fudge_Brownies"},"image":"","cuisine":"","country":"","region":"Global","course":"dessert","protein":"veggie","diet":2,"allergens":23,"minutes":30,"time":{"prep":10,"cook":20,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"","difficulty":"easy","ingredients":[{"item":"¾ cup (1.2 dl) butter or margarine","qty":""},{"item":"1 cup (240 ml) white granulated sugar","qty":""},{"item":"1 ½ tbsp oil","qty":""},{"item":"⅓ cup (80 ml) milk","qty":""},{"item":"2 eggs","qty":""},{"item":"6 tbsp cocoa powder","qty":""},{"item":"¾ cup (180 ml) flour, sifted","qty":""},{"item":"½ tsp almond extract or ½ cup (120 ml) chopped almonds","qty":""},{"item":"1 tsp vanilla extract","qty":""}],"steps":["Preheat oven to 350°F (175°C).","Cream butter and sugar.","Beat in oil and milk.","Blend in eggs, one at a time.","Mix in vanilla and almond extract (or almonds).","Mix in cocoa and flour.","Spread into greased 10.5 x 7-inch cake pan.","Bake for 28–30 minutes. A toothpick inserted into the center should come out with no more than moist crumbs.","Allow to cool completely."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":3,"era":"modern"}