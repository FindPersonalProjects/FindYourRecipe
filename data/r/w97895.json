{"id":"w97895","name":"Cheese Spread on French Bread","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Cheese_Spread_on_French_Bread"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Cheese_Spread_on_French_Bread"},"image":"","cuisine":"French","country":"","region":"Europe","course":"side","protein":"veggie","diet":2,"allergens":18435,"minutes":240,"time":{"prep":20,"cook":0,"passive":220,"passiveWhy":["chilling"]},"timeEstimated":false,"servings":"8","difficulty":"easy","ingredients":[{"item":"½ tbsp Dijon mustard","qty":""},{"item":"1 tbsp butter, room temperature","qty":""},{"item":"2 tsp dried sage","qty":""},{"item":"¼ cup apple juice","qty":""},{"item":"2 cups shredded sharp cheddar cheese","qty":""},{"item":"½ tsp pepper","qty":""},{"item":"8 oz package cream cheese, softened","qty":""},{"item":"1 loaf French bread, cut in small slices","qty":""}],"steps":["In a large bowl, mix together mustard, butter, and sage.","Add the apple juice, cheddar cheese, and pepper, then stir well.","Add the cream cheese, blending well.","Cover and refrigerate for 3 hours.","When ready to serve, remove from refrigerator and allow to stand for ½ hour.","Spread on bread and serve with milk."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":67,"era":"modern"}