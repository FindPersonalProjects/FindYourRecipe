{"id":"w172390","name":"Bacon and Cheese Puffs","author":"Wikibooks Cookbook contributors","source":{"name":"Wikibooks Cookbook","url":"https://en.wikibooks.org/wiki/Cookbook:Bacon_and_Cheese_Puffs"},"via":{"name":"Wikibooks","url":"https://en.wikibooks.org/wiki/Cookbook:Bacon_and_Cheese_Puffs"},"image":"","cuisine":"","country":"","region":"Global","course":"side","protein":"pork","diet":0,"allergens":1313287,"minutes":60,"time":{"prep":20,"cook":40,"passive":0,"passiveWhy":[]},"timeEstimated":false,"servings":"","difficulty":"easy","ingredients":[{"item":"Milk","qty":"½ cup / 122 g"},{"item":"Egg, lightly beaten","qty":"1 each. / 50 g"},{"item":"Coarsely-grated cheddar cheese","qty":"2 cups / 226 g"},{"item":"Bacon rashers, chopped","qty":"6–8 each. / 82.8–110.4 g"},{"item":"Small onions, finely chopped","qty":"2 each. / 140 g"},{"item":"Self-raising flour","qty":"1 cup / 125 g"},{"item":"Dijon mustard","qty":"1 tsp / 5 g"}],"steps":["Combine the milk and egg in a bowl, and mix well. Add cheese, bacon, onions, sifted flour and mustard, then mix well.","Drop rounded tsp of the mixture onto a tray lined with baking paper.","Bake in a hot oven of 200°C (400°F) degrees for about 15 minutes, or until golden.","Serve warm or cold and garnished with fresh herbs."],"tags":[],"youtube":"","culture":null,"license":"CC BY-SA 4.0","lifestyle":64,"era":"modern"}